meta {
  name: Refactoring_RevertRename
  type: http
  seq: 105
}

post {
  url: http://localhost:{{port}}/ame/api/refactoring/history/{{refactoringId}}/revert
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("The reverted refactoring is returned", function() {
    expect(res.getBody().id).to.equal(bru.getVar("refactoringId"));
  });
}
