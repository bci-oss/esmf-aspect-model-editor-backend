meta {
  name: Refactoring_GetHistory
  type: http
  seq: 104
}

get {
  url: http://localhost:{{port}}/ame/api/refactoring/history
  body: none
  auth: none
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("The latest refactoring is listed first", function() {
    const body = res.getBody();
    expect(body[0].id).to.equal(bru.getVar("refactoringId"));
    expect(body[0].description).to.equal("Rename sharedProperty to renamedProperty");
  });

  test("The request of the refactoring is stored to offer its revert", function() {
    const request = res.getBody()[0].request;
    expect(request.type).to.equal("RENAME_ELEMENT");
    expect(request.newName).to.equal("renamedProperty");
  });
}
