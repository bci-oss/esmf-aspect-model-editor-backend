meta {
  name: Refactoring_PreviewRename_InvalidRequest
  type: http
  seq: 101
}

post {
  url: http://localhost:{{port}}/ame/api/refactoring/preview
  body: json
  auth: none
}

body:json {
  {
    "type": "RENAME_ELEMENT",
    "urn": "urn:samm:org.eclipse.bruno.refactoring:1.0.0#sharedProperty"
  }
}

tests {
  test("Status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Error message names the missing value", function() {
    expect(res.getBody().error.message).to.include("newName");
  });
}
