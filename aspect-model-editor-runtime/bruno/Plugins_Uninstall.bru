meta {
  name: Plugins_Uninstall
  type: http
  seq: 136
}

delete {
  url: http://localhost:{{port}}/ame/api/plugins/bruno-test
  body: none
  auth: none
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("The plugin is removed without restart as it never ran", function() {
    const body = res.getBody();
    expect(body.plugins.map(plugin => plugin.id)).to.not.include("bruno-test");
    expect(body.restartRequired).to.equal(false);
  });
}
