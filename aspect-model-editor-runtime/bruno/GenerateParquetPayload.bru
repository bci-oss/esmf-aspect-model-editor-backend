meta {
  name: GenerateParquetPayload
  type: http
  seq: 122
}

post {
  url: http://localhost:{{port}}/ame/api/generate/parquet-payload
  body: multipartForm
  auth: none
}

headers {
  uri: blob://movement.ttl
}

body:multipart-form {
  aspectModel: @file(./TestingFiles/Movement.ttl)
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Content type is application/vnd.apache.parquet", function() {
    expect(res.getHeader("content-type")).to.include("application/vnd.apache.parquet");
  });
}
