meta {
  name: ResetWorkspaces
  type: http
  seq: 69
}

post {
  url: http://localhost:{{port}}/ame/api/workspaces/reset
  body: none
  auth: none
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response reset to default", function() {
    const data = res.getBody();
    expect(data.workspaces).to.be.an("array");
    expect(data.workspaces.length).to.equal(1);
    expect(data.activeWorkspace).to.equal(data.workspaces[0]);
  });
}
