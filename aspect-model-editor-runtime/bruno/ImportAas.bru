meta {
  name: ImportAas
  type: http
  seq: 117
}

post {
  url: http://localhost:{{port}}/ame/api/package/import-aas
  body: multipartForm
  auth: none
}

body:multipart-form {
  aasFile: @file(./TestingFiles/MovementAas.json)
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Imported model is grouped by namespace", function() {
    const data = res.getBody();
    expect(data).to.have.property("org.eclipse.esmf.aasimport");
  });
}
