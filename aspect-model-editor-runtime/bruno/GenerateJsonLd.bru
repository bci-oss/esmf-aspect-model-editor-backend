meta {
  name: GenerateJsonLd
  type: http
  seq: 115
}

post {
  url: http://localhost:{{port}}/ame/api/generate/json-ld
  body: multipartForm
  auth: none
}

headers {
  uri: blob://movement.ttl
}

body:multipart-form {
  aspectModel: @file(./TestingFiles/Movement.ttl)
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Content type is application/ld+json", function() {
    expect(res.getHeader("content-type")).to.include("application/ld+json");
  });

  test("Response is a JSON-LD document", function() {
    const body = typeof res.getBody() === "string" ? JSON.parse(res.getBody()) : res.getBody();
    expect(body).to.have.property("@context");
  });
}
