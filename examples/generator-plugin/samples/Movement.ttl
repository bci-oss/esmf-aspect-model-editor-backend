@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:samm:org.example.movement:1.0.0#> .

:Movement a samm:Aspect ;
   samm:preferredName "Movement"@en ;
   samm:description "Describes the movement of a vehicle."@en ;
   samm:description "Beschreibt die Bewegung eines Fahrzeugs."@de ;
   samm:properties ( :speed :moving [ samm:property :driver ; samm:optional true ] :timestamp ) ;
   samm:operations ( ) .

:speed a samm:Property ;
   samm:description "The current speed of the vehicle."@en ;
   samm:characteristic :Speed .

:moving a samm:Property ;
   samm:description "Whether the vehicle is moving."@en ;
   samm:characteristic samm-c:Boolean .

:driver a samm:Property ;
   samm:description "The name of the driver."@en ;
   samm:characteristic samm-c:Text .

:timestamp a samm:Property ;
   samm:characteristic samm-c:Timestamp .

:Speed a samm-c:Measurement ;
   samm:dataType xsd:float ;
   samm-c:unit unit:kilometrePerHour .
