<!-- Starts the backend from IntelliJ IDEA with the JVM options of the packaged app image (see README "Build and run") -->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="AME Backend" type="Application" factoryName="Application">
    <option name="MAIN_CLASS_NAME" value="org.eclipse.esmf.ame.Application" />
    <module name="aspect-model-editor-runtime" />
    <option name="VM_PARAMETERS" value="--enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -Dpolyglotimpl.DisableMultiReleaseCheck=true" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
